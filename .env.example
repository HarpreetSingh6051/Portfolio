# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Contact form (Web3Forms) ---
# Public access key that lets the contact form email you through Web3Forms.
# It is a *public form identifier*, not a secret: Web3Forms expects it in
# client-side code (see https://docs.web3forms.com/getting-started/api-reference)
# and lets you restrict it to your domain from the dashboard.
# Get a free key: go to https://web3forms.com, enter your email, and copy the key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Optional ---
# Canonical production URL used for metadata, sitemap.xml, and robots.txt.
# e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://portfolio-harpreet-singh3.vercel.app/

